# Copy to .env to customize. A working .env with these same defaults is
# committed so `docker compose up` works with no setup.

# Flag for the sqli_login challenge. Change it if you want a fresh value
# that isn't the one printed in this repo's README.
SQLI_LOGIN_FLAG=FLAG{sqli_bypass_achieved_2026}

# Flag for the xss_feedback challenge.
XSS_FEEDBACK_FLAG=FLAG{xss_admin_bot_pwned_2026}

# Flag for the idor_invoices challenge.
IDOR_INVOICES_FLAG=FLAG{idor_missing_ownership_check_2026}

# Flag for the exposed_config challenge.
EXPOSED_CONFIG_FLAG=FLAG{leaked_backup_api_key_2026}

# Flag for the vulnerable_component challenge.
VULNERABLE_COMPONENT_FLAG=FLAG{outdated_apache_cgi_rce_2026}

# Flag for the forgeable_token challenge.
FORGEABLE_TOKEN_FLAG=FLAG{forged_admin_role_token_2026}

# Flag for the business_logic challenge.
BUSINESS_LOGIC_FLAG=FLAG{negative_quantity_balance_abuse_2026}

# Shared secret the arena uses to authorize its calls to each target's
# /reset route. Generate your own with: python3 -c "import secrets; print(secrets.token_hex(24))"
RESET_TOKEN=change_me_to_a_random_value
